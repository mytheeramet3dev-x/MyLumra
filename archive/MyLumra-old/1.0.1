/// Custom AsyncRead + AsyncWrite wrapper สำหรับ rustls
/// เขียนเองด้วยมือเปล่า ไม่ใช้ tokio-rustls
pub struct ManualTlsStream {
    tcp: TcpStream,
    tls: ClientConnection,
    // Buffers for manual I/O
    read_buf: BytesMut,
    write_buf: BytesMut,
    // State tracking
    handshake_done: bool,
}

impl ManualTlsStream {
    /// สร้าง TLS connection แบบ manual
    pub async fn connect(
        host: &str,
        port: u16,
        config: Arc<ClientConfig>,
    ) -> io::Result<Self> {
        // 1. DNS Resolution ด้วย hickory
        let resolver = TokioAsyncResolver::tokio(
            ResolverConfig::default(),
            ResolverOpts::default(),
        );
        
        let ip = resolver
            .lookup_ip(host)
            .await
            .map_err(|e| io::Error::new(io::ErrorKind::NotFound, e))?
            .iter()
            .next()
            .ok_or_else(|| io::Error::new(io::ErrorKind::NotFound, "No IP found"))?;

        // 2. TCP Connect
        let addr = (ip, port).to_socket_addrs()?.next().unwrap();
        let tcp = TcpStream::connect(addr).await?;

        // 3. สร้าง TLS ClientConnection
        let server_name = ServerName::try_from(host.to_string())
            .map_err(|e| io::Error::new(io::ErrorKind::InvalidInput, e))?;
        
        let tls = ClientConnection::new(config, server_name)
            .map_err(|e| io::Error::new(io::ErrorKind::Other, e))?;

        let mut stream = ManualTlsStream {
            tcp,
            tls,
            read_buf: BytesMut::with_capacity(16 * 1024),
            write_buf: BytesMut::with_capacity(16 * 1024),
            handshake_done: false,
        };

        // 4. Manual TLS Handshake
        stream.do_handshake().await?;

        Ok(stream)
    }

    /// Manual TLS Handshake - เขียนเองทั้งหมด
    async fn do_handshake(&mut self) -> io::Result<()> {
        use tokio::io::{AsyncReadExt, AsyncWriteExt};

        loop {
            // Check if handshake is complete
            if !self.tls.is_handshaking() {
                self.handshake_done = true;
                return Ok(());
            }

            // Write TLS data to TCP
            while self.tls.wants_write() {
                self.write_buf.clear();
                let n = self.tls.write_tls(&mut self.write_buf.writer())
                    .map_err(|e| io::Error::new(io::ErrorKind::Other, e))?;
                if n > 0 {
                    self.tcp.write_all(&self.write_buf[..n]).await?;
                }
            }

            // Read TLS data from TCP
            if self.tls.wants_read() {
                let mut buf = [0u8; 4096];
                let n = self.tcp.read(&mut buf).await?;
                if n == 0 {
                    return Err(io::Error::new(
                        io::ErrorKind::UnexpectedEof,
                        "Connection closed during handshake"
                    ));
                }
                self.tls.read_tls(&mut &buf[..n])
                    .map_err(|e| io::Error::new(io::ErrorKind::Other, e))?;
            }

            // Process TLS state
            self.tls.process_new_packets()
                .map_err(|e| io::Error::new(io::ErrorKind::Other, e))?;
        }
    }

    /// อ่าน decrypted data
    pub async fn read_plaintext(&mut self, buf: &mut [u8]) -> io::Result<usize> {
        use tokio::io::{AsyncReadExt, AsyncWriteExt};

        loop {
            // Try to read from TLS first
            match self.tls.reader().read(buf) {
                Ok(n) if n > 0 => return Ok(n),
                Ok(_) => {}
                Err(ref e) if e.kind() == io::ErrorKind::WouldBlock => {}
                Err(e) => return Err(e),
            }

            // Need more data from TCP
            if self.tls.wants_read() {
                let mut tcp_buf = [0u8; 4096];
                let n = self.tcp.read(&mut tcp_buf).await?;
                if n == 0 {
                    return Ok(0); // EOF
                }
                self.tls.read_tls(&mut &tcp_buf[..n])
                    .map_err(|e| io::Error::new(io::ErrorKind::Other, e))?;
                self.tls.process_new_packets()
                    .map_err(|e| io::Error::new(io::ErrorKind::Other, e))?;
            }

            // Send any pending TLS data
            while self.tls.wants_write() {
                self.write_buf.clear();
                let n = self.tls.write_tls(&mut self.write_buf.writer())
                    .map_err(|e| io::Error::new(io::ErrorKind::Other, e))?;
                if n > 0 {
                    self.tcp.write_all(&self.write_buf[..n]).await?;
                }
            }
        }
    }

    /// เขียน plaintext data
    pub async fn write_plaintext(&mut self, buf: &[u8]) -> io::Result<usize> {
        use tokio::io::AsyncWriteExt;

        // Write to TLS
        let n = self.tls.writer().write(buf)
            .map_err(|e| io::Error::new(io::ErrorKind::Other, e))?;

        // Flush TLS data to TCP
        while self.tls.wants_write() {
            self.write_buf.clear();
            let written = self.tls.write_tls(&mut self.write_buf.writer())
                .map_err(|e| io::Error::new(io::ErrorKind::Other, e))?;
            if written > 0 {
                self.tcp.write_all(&self.write_buf[..written]).await?;
            }
        }

        Ok(n)
    }

    /// Check if using TLS 1.3
    pub fn is_tls_13(&self) -> bool {
        self.tls.protocol_version() == Some(rustls::ProtocolVersion::TLSv1_3)
    }

    /// Get cipher suite info
    pub fn cipher_suite(&self) -> Option<&'static str> {
        self.tls.negotiated_cipher_suite().map(|cs| cs.suite().as_str().unwrap_or("unknown"))
    }
}

// Implement AsyncRead for ManualTlsStream
impl AsyncRead for ManualTlsStream {
    fn poll_read(
        self: Pin<&mut Self>,
        cx: &mut Context<'_>,
        buf: &mut ReadBuf<'_>,
    ) -> Poll<io::Result<()>> {
        // Simplified - in production, use proper async state machine
        Poll::Pending
    }
}

// Implement AsyncWrite for ManualTlsStream
impl AsyncWrite for ManualTlsStream {
    fn poll_write(
        self: Pin<&mut Self>,
        cx: &mut Context<'_>,
        buf: &[u8],
    ) -> Poll<io::Result<usize>> {
        Poll::Pending
    }

    fn poll_flush(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
        Poll::Ready(Ok(()))
    }

    fn poll_shutdown(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
        Poll::Ready(Ok(()))
    }
}

