/// Post-Quantum Hybrid Key Exchange
/// ใช้ Kyber-1024 สำหรับ KEM + X25519 สำหรับ classical
pub mod post_quantum {
    use super::*;

    // Kyber-1024 parameters
    pub const KYBER_PK_SIZE: usize = 1568;
    pub const KYBER_SK_SIZE: usize = 3168;
    pub const KYBER_CT_SIZE: usize = 1568;
    pub const KYBER_SS_SIZE: usize = 32;

    // Dilithium-3 parameters
    pub const DILITHIUM_PK_SIZE: usize = 1952;
    pub const DILITHIUM_SK_SIZE: usize = 4000;
    pub const DILITHIUM_SIG_SIZE: usize = 3293;

    /// Hybrid Key Exchange Result
    #[derive(Debug)]
    pub struct HybridKeyExchange {
        pub classical_secret: [u8; 32],  // X25519
        pub pq_secret: [u8; 32],         // Kyber
        pub combined_secret: [u8; 32],   // HKDF(classical || pq)
    }

    /// PQ Connection Status for UI
    #[derive(Debug, Clone, Copy, PartialEq)]
    pub enum PQStatus {
        Classical,           // TLS 1.3 only
        Hybrid,              // TLS 1.3 + Kyber
        FullQuantumSafe,     // Full PQ (Kyber + Dilithium)
    }

    impl PQStatus {
        pub fn display_string(&self) -> &'static str {
            match self {
                PQStatus::Classical => "🔒 TLS 1.3",
                PQStatus::Hybrid => "🔐 Quantum-Hybrid",
                PQStatus::FullQuantumSafe => "🛡️ Quantum-Safe",
            }
        }
    }

    /// Simplified Kyber-like KEM (for demonstration)
    /// In production, use pqcrypto::kem::kyber1024
    pub struct KyberKEM {
        pub public_key: [u8; KYBER_PK_SIZE],
        secret_key: [u8; KYBER_SK_SIZE],
    }

    impl KyberKEM {
        /// Generate keypair
        pub fn keygen() -> Self {
            // In production: pqcrypto::kem::kyber1024::keypair()
            let mut pk = [0u8; KYBER_PK_SIZE];
            let mut sk = [0u8; KYBER_SK_SIZE];
            
            // Fill with pseudo-random (use real RNG in production)
            getrandom::getrandom(&mut pk).unwrap();
            getrandom::getrandom(&mut sk).unwrap();
            
            KyberKEM {
                public_key: pk,
                secret_key: sk,
            }
        }

        /// Encapsulate - สร้าง shared secret + ciphertext
        pub fn encapsulate(peer_pk: &[u8; KYBER_PK_SIZE]) -> ([u8; KYBER_CT_SIZE], [u8; KYBER_SS_SIZE]) {
            // In production: pqcrypto::kem::kyber1024::encapsulate(pk)
            let mut ct = [0u8; KYBER_CT_SIZE];
            let mut ss = [0u8; KYBER_SS_SIZE];
            
            getrandom::getrandom(&mut ct).unwrap();
            getrandom::getrandom(&mut ss).unwrap();
            
            (ct, ss)
        }

        /// Decapsulate - recover shared secret from ciphertext
        pub fn decapsulate(&self, ct: &[u8; KYBER_CT_SIZE]) -> [u8; KYBER_SS_SIZE] {
            // In production: pqcrypto::kem::kyber1024::decapsulate(ct, sk)
            let mut ss = [0u8; KYBER_SS_SIZE];
            getrandom::getrandom(&mut ss).unwrap();
            ss
        }
    }

    /// Hybrid TLS Config with PQ support
    pub fn create_hybrid_tls_config() -> Arc<ClientConfig> {
        let mut root_store = RootCertStore::empty();
        
        // Add system root certificates
        root_store.extend(
            webpki_roots::TLS_SERVER_ROOTS.iter().cloned()
        );

        let config = ClientConfig::builder()
            .with_root_certificates(root_store)
            .with_no_client_auth();

        // Note: For real PQ support, need rustls with experimental PQ features
        // or custom CryptoProvider with Kyber

        Arc::new(config)
    }

    /// Perform hybrid key exchange
    pub async fn hybrid_handshake(
        stream: &mut ManualTlsStream,
    ) -> io::Result<HybridKeyExchange> {
        // 1. Classical TLS 1.3 is already done
        let classical_secret = [0u8; 32]; // From TLS session

        // 2. PQ Key Exchange (piggyback on TLS)
        let kem = KyberKEM::keygen();
        
        // Send our PK (in real impl, use TLS extension)
        stream.write_plaintext(&kem.public_key).await?;
        
        // Receive peer's ciphertext
        let mut ct = [0u8; KYBER_CT_SIZE];
        let mut total_read = 0;
        while total_read < KYBER_CT_SIZE {
            let n = stream.read_plaintext(&mut ct[total_read..]).await?;
            if n == 0 {
                return Err(io::Error::new(io::ErrorKind::UnexpectedEof, "PQ handshake failed"));
            }
            total_read += n;
        }
        
        // Decapsulate to get PQ shared secret
        let pq_secret = kem.decapsulate(&ct);

        // 3. Combine secrets with HKDF
        let combined_secret = combine_secrets(&classical_secret, &pq_secret);

        Ok(HybridKeyExchange {
            classical_secret,
            pq_secret,
            combined_secret,
        })
    }

    /// HKDF to combine classical + PQ secrets
    fn combine_secrets(classical: &[u8; 32], pq: &[u8; 32]) -> [u8; 32] {
        use sha2::{Sha256, Digest};
        
        let mut hasher = Sha256::new();
        hasher.update(b"lumra-hybrid-v1");
        hasher.update(classical);
        hasher.update(pq);
        
        let result = hasher.finalize();
        let mut combined = [0u8; 32];
        combined.copy_from_slice(&result);
        combined
    }
}

// ============================================================================
// TASK #2: ZERO-COPY PIPELINE - DISK → RENDER ไม่มี ALLOCATION
// ============================================================================

pub mod zero_copy_pipeline {
    use super::*;
    use brotli::Decompressor;
    use std::io::BufRead;

    /// Zero-copy cache entry (from previous implementation)
    pub struct ZeroCopyEntry {
        mmap: Mmap,
        compressed_size: usize,
        original_size: usize,
    }

    impl ZeroCopyEntry {
        /// Get compressed bytes directly (zero-copy)
        #[inline]
        pub fn compressed_bytes(&self) -> &[u8] {
            &self.mmap[8..]
        }

        /// Streaming decompressor - ไม่ต้อง allocate ทั้งหมดก่อน
        pub fn streaming_reader(&self) -> StreamingDecompressor<'_> {
            StreamingDecompressor::new(self.compressed_bytes())
        }
    }

    /// Streaming Brotli decompressor
    pub struct StreamingDecompressor<'a> {
        inner: Decompressor<&'a [u8]>,
        buffer: [u8; 4096],
        buf_pos: usize,
        buf_len: usize,
    }

    impl<'a> StreamingDecompressor<'a> {
        pub fn new(compressed: &'a [u8]) -> Self {
            StreamingDecompressor {
                inner: Decompressor::new(compressed, 4096),
                buffer: [0u8; 4096],
                buf_pos: 0,
                buf_len: 0,
            }
        }
    }

    impl<'a> Iterator for StreamingDecompressor<'a> {
        type Item = io::Result<u8>;

        fn next(&mut self) -> Option<Self::Item> {
            if self.buf_pos >= self.buf_len {
                // Refill buffer
                match self.inner.read(&mut self.buffer) {
                    Ok(0) => return None,
                    Ok(n) => {
                        self.buf_len = n;
                        self.buf_pos = 0;
                    }
                    Err(e) => return Some(Err(e)),
                }
            }
            let byte = self.buffer[self.buf_pos];
            self.buf_pos += 1;
            Some(Ok(byte))
        }
    }

    /// Zero-copy HTML renderer
    /// รับ ZeroCopyEntry โดยตรง ไม่ต้อง to_bytes()
    pub struct ZeroCopyRenderer<'a> {
        decompressor: StreamingDecompressor<'a>,
        state: RenderState,
        output_buf: [u8; 8192],
        output_len: usize,
    }

    #[derive(Default)]
    struct RenderState {
        in_tag: bool,
        in_script: bool,
        in_style: bool,
        tag_buf: [u8; 64],
        tag_len: usize,
    }

    impl<'a> ZeroCopyRenderer<'a> {
        pub fn new(entry: &'a ZeroCopyEntry) -> Self {
            ZeroCopyRenderer {
                decompressor: entry.streaming_reader(),
                state: RenderState::default(),
                output_buf: [0u8; 8192],
                output_len: 0,
            }
        }

        /// Render next chunk of text
        /// Returns None when done
        pub fn next_chunk(&mut self) -> Option<&str> {
            self.output_len = 0;

            while self.output_len < self.output_buf.len() - 1 {
                let byte = match self.decompressor.next() {
                    Some(Ok(b)) => b,
                    Some(Err(_)) => break,
                    None => break,
                };

                match byte {
                    b'<' => {
                        self.state.in_tag = true;
                        self.state.tag_len = 0;
                    }
                    b'>' if self.state.in_tag => {
                        self.state.in_tag = false;
                        self.check_tag();
                    }
                    _ if self.state.in_tag => {
                        if self.state.tag_len < 64 {
                            self.state.tag_buf[self.state.tag_len] = byte.to_ascii_lowercase();
                            self.state.tag_len += 1;
                        }
                    }
                    _ if !self.state.in_script && !self.state.in_style => {
                        // Output visible text
                        if byte == b'\n' || byte == b'\r' {
                            if self.output_len > 0 && self.output_buf[self.output_len - 1] != b' ' {
                                self.output_buf[self.output_len] = b' ';
                                self.output_len += 1;
                            }
                        } else if byte >= 0x20 && byte < 0x7F {
                            self.output_buf[self.output_len] = byte;
                            self.output_len += 1;
                        }
                    }
                    _ => {}
                }
            }

            if self.output_len > 0 {
                Some(std::str::from_utf8(&self.output_buf[..self.output_len]).unwrap_or(""))
            } else {
                None
            }
        }

        fn check_tag(&mut self) {
            let tag = &self.state.tag_buf[..self.state.tag_len];
            
            if tag == b"script" {
                self.state.in_script = true;
            } else if tag == b"/script" {
                self.state.in_script = false;
            } else if tag == b"style" {
                self.state.in_style = true;
            } else if tag == b"/style" {
                self.state.in_style = false;
            }
        }
    }

    /// Complete zero-copy render function
    /// ไม่มี Vec<u8> allocation เลย!
    pub fn render_zero_copy<'a>(
        entry: &'a ZeroCopyEntry,
        output: &mut impl std::fmt::Write,
    ) -> std::fmt::Result {
        let mut renderer = ZeroCopyRenderer::new(entry);
        
        while let Some(chunk) = renderer.next_chunk() {
            output.write_str(chunk)?;
        }
        
        Ok(())
    }
}

