pub struct LumraHttpClient {
    config: Arc<ClientConfig>,
    pq_enabled: bool,
}

impl LumraHttpClient {
    pub fn new(pq_enabled: bool) -> Self {
        LumraHttpClient {
            config: if pq_enabled {
                post_quantum::create_hybrid_tls_config()
            } else {
                Self::create_standard_config()
            },
            pq_enabled,
        }
    }

    fn create_standard_config() -> Arc<ClientConfig> {
        let mut root_store = RootCertStore::empty();
        root_store.extend(webpki_roots::TLS_SERVER_ROOTS.iter().cloned());
        
        Arc::new(
            ClientConfig::builder()
                .with_root_certificates(root_store)
                .with_no_client_auth()
        )
    }

    /// Fetch URL with manual TLS
    pub async fn get(&self, url: &str) -> io::Result<(Bytes, post_quantum::PQStatus)> {
        let parsed = url::Url::parse(url)